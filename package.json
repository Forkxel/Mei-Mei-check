{
  "name": "mei-mei-check",
  "displayName": "Mei Mei check",
  "description": "This extension will check your code and give you picture of Mei Mei Leopard based on if it is correctly written.",
  "version": "0.0.1",
  "publisher": "Pavel Halík",
  "engines": {
    "vscode": "^1.145.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "mei-mei-check.run",
        "title": "Mei Mei Check"
      }
    ],
    "menus": {
    "editor/title": [
      {
        "command": "mei-mei-check.run",
        "group": "navigation"
      }
    ],
    "editor/context": [
      {
        "command": "mei-mei-check.run",
        "group": "navigation"
      }
    ]
  }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.145.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
